{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spider numeric evidence extraction",
  "type": "object",
  "required": [
    "id",
    "source_id",
    "species",
    "sex_stage",
    "sample_size",
    "eye_identity",
    "stimulus",
    "measured_quantity",
    "value",
    "unit",
    "methods",
    "limitations",
    "quote",
    "locator"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "species": {
      "type": "string",
      "minLength": 1
    },
    "sex_stage": {
      "type": "string",
      "minLength": 1
    },
    "sample_size": {
      "type": "object"
    },
    "eye_identity": {
      "type": "string",
      "minLength": 1
    },
    "stimulus": {
      "type": "string",
      "minLength": 1
    },
    "measured_quantity": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": [
        "number",
        "array",
        "string"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "methods": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "quote": {
      "type": "string",
      "minLength": 20
    },
    "locator": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
